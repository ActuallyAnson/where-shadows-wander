# Dependencies
node_modules/

# Build output
dist/
dist-*/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Certificates and signing keys (dev HTTPS certs, Android/TWA signing)
.iwsdk/
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.keystore
*.jks

# Packaged builds
*.apk
*.aab

# Large recorded hand-tracking data (keep small fixtures elsewhere, or use Git LFS)
recordings/
*.handrec
*.handrec.json
# ...except the small regression fixtures the tests replay (src/engine/hands/fixtures, under 256 KB each)
!src/engine/hands/fixtures/*.handrec.json
!src/engine/hands/fixtures/gestures/*.handrec.json

# Classifier evaluation reports (npm run eval)
eval-reports/

# Editor folders
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Generated by the IWSDK CLI / dev server
**/.mcp.json
**/.cursor/mcp.json
**/.codex/config.toml
