{
  "name": "where-shadows-wander",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "check:three": "node scripts/check-single-three.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:three && npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@iwsdk/core": "1.0.0",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iwsdk/cli": "1.0.0",
    "@iwsdk/vite-plugin-dev": "1.0.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@types/three": "0.181.0",
    "@types/webxr": "0.5.24",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "overrides": {
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
