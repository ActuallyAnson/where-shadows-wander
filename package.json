{
  "name": "where-shadows-wander",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:three": "node scripts/check-single-three.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run check:three && npm test"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.0",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.0",
    "@iwsdk/vite-plugin-dev": "1.0.0",
    "@types/three": "0.181.0",
    "@types/webxr": "0.5.24",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "overrides": {
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
